# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Канал (короткий id 4339622999 → полный формат с префиксом -100)
CHANNEL_ID=-1004339622999

# Группа обсуждения канала
DISCUSSION_CHAT_ID=-1004332798085

# Ссылка на канал для кнопки в /start
CHANNEL_URL=https://t.me/your_channel

# Время жизни приветствия в группе (секунды)
GREETING_TTL=10

# Удалять служебные сообщения «вошёл / вышел» (1 = да)
DELETE_SERVICE_MESSAGE=1

# Отправлять правила первым комментарием под новыми постами (1 = да)
RULES_ENABLED=1

# PNG лежит в корне рядом с bot.py; свой файл можно подставить без правки кода
RULES_IMAGE=rules.png

# ─── Модерация и антиспам ───
# Сколько предупреждений до автоматического мута
WARN_LIMIT=3

# Длительность автомута при достижении лимита (секунды, 86400 = сутки)
WARN_MUTE=86400

# Порог срабатывания антиспама (ниже = строже, 4 — сбалансированно)
SPAM_THRESHOLD=4

# Через сколько секунд удаляются служебные ответы бота
NOTICE_TTL=20

# ─── Веб-интерфейс и статистика ───
# Хостинг пробрасывает этот порт на домен с SSL
WEB_HOST=0.0.0.0
WEB_PORT=3000
DOMAIN=serp.bothost.tech

# Файл базы статистики (создаётся автоматически рядом с bot.py)
STATS_DB=stats.db
